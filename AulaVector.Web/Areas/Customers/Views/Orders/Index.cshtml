@model IEnumerable<AulaVector.Models.Order>

@{
    ViewData["Title"] = "Order History";
}

<div class="container mt-5">
    <h2 class="mb-4"><i class="bi bi-receipt"></i> Order History</h2>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Order ID</th>
                            <th>Date</th>
                            <th>Total Amount</th>
                            <th>Payment Method</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">No orders found in your history.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="align-middle">@item.Id.ToString().Substring(0, 8)...</td>
                                    <td class="align-middle">@item.CreatedAt.ToString("g")</td>
                                    <td class="align-middle">@item.TotalAmount.ToString("C") @item.Currency</td>
                                    <td class="align-middle">@item.PaymentMethod</td>
                                    <td class="align-middle">
                                        @switch (item.PaymentStatus)
                                        {
                                            case AulaVector.Models.Enums.PaymentStatus.Approved:
                                                <span class="badge bg-success">Approved</span>
                                                break;
                                            case AulaVector.Models.Enums.PaymentStatus.Pending:
                                                <span class="badge bg-warning text-dark">Pending</span>
                                                break;
                                            case AulaVector.Models.Enums.PaymentStatus.Canceled:
                                                <span class="badge bg-danger">Canceled</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@item.PaymentStatus</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-center align-middle">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                            View Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>