@model ApplicationUser

@{
    ViewData["Title"] = "Detalle del Usuario";
    Layout = "_Layout";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Detalle del Usuario</h2>
            <p class="text-muted mb-0">
                Información completa del cliente registrado.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-person-badge me-2"></i>Información del Usuario
            </h5>
        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-6">
                    <label class="form-label fw-semibold text-muted">
                        Nombre
                    </label>
                    <div class="form-control bg-light">
                        @Model.FirstName
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold text-muted">
                        Apellidos
                    </label>
                    <div class="form-control bg-light">
                        @Model.LastName
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold text-muted">
                        Correo electrónico
                    </label>
                    <div class="form-control bg-light">
                        @Model.Email
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold text-muted">
                        Nombre de usuario
                    </label>
                    <div class="form-control bg-light">
                        @Model.UserName
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold text-muted">
                        Teléfono
                    </label>
                    <div class="form-control bg-light">
                        @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                            ? "No registrado"
                            : Model.PhoneNumber)
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold text-muted">
                        País
                    </label>
                    <div class="form-control bg-light">
                        @(string.IsNullOrWhiteSpace(Model.Country)
                            ? "No registrado"
                            : Model.Country)
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold text-muted">
                        Fecha de registro
                    </label>
                    <div class="form-control bg-light">
                        @Model.RegistrationDate.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold text-muted">
                        Estado
                    </label>
                    <div>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success fs-6">
                                Activo
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6">
                                Inactivo
                            </span>
                        }
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold text-muted">
                        Correo confirmado
                    </label>
                    <div>
                        @if (Model.EmailConfirmed)
                        {
                            <span class="badge bg-success fs-6">
                                Confirmado
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark fs-6">
                                Pendiente
                            </span>
                        }
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold text-muted">
                        Teléfono confirmado
                    </label>
                    <div>
                        @if (Model.PhoneNumberConfirmed)
                        {
                            <span class="badge bg-success fs-6">
                                Confirmado
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark fs-6">
                                Pendiente
                            </span>
                        }
                    </div>
                </div>

            </div>

        </div>

        <div class="card-footer d-flex justify-content-end gap-2">
            <a asp-action="Index"
               class="btn btn-secondary">
                <i class="bi bi-list me-1"></i>
                Volver al listado
            </a>
        </div>
    </div>

</div>