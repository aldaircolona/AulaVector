@model IEnumerable<Product>

@{
    ViewData["Title"] = "Gestión de Productos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-3"> 
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Productos Digitales</h1>
            <p class="text-muted small mb-0">Administración e inventario de libros y recursos descargables.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Nuevo Producto
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="width: 80px;">Portada</th>
                            <th scope="col">Título</th>
                            <th scope="col">Precio</th>
                            <th scope="col">Estado</th>
                            <th scope="col">Fecha Registro</th>
                            <th scope="col" class="text-end" style="width: 180px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    No hay productos registrados en el sistema.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.CoverImageUrl))
                                        {
                                            <img src="@item.CoverImageUrl" alt="@item.Title" class="img-thumbnail rounded" style="width: 50px; height: 60px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-secondary text-white rounded d-flex align-items-center justify-content-center" style="width: 50px; height: 60px;">
                                                <i class="bi bi-book fs-4"></i>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.Title</div>
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 300px;">@item.Description</small>
                                    </td>
                                    <td class="fw-semibold text-success">
                                        $@item.Price.ToString("F2")
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactivo</span>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</small>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn @(item.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(item.IsActive ? "Deshabilitar" : "Habilitar")">
                                                    <i class="bi @(item.IsActive ? "bi-slash-circle" : "bi-check-circle")"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>