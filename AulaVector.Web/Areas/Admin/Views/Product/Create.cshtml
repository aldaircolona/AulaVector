@model Product

@{
    ViewData["Title"] = "Crear Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-3">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left"></i> Volver a la lista
        </a>
        <h1 class="h3 mb-0 text-gray-800 mt-2">Crear Nuevo Producto Digital</h1>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Create" enctype="multipart/form-data" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold">Título del Producto / Libro</label>
                            <input asp-for="Title" class="form-control" placeholder="Ej. Manual Avanzado de C# MVC" required />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">Descripción detallada</label>
                            <textarea asp-for="Description" class="form-control" rows="5" placeholder="Escribe el resumen o índice del producto..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="Price" class="form-label fw-bold">Precio ($)</label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Imagen de Portada (JPG/PNG)</label>
                            <input type="file" name="coverFile" class="form-control" accept="image/*" />
                            <small class="form-text text-muted">Archivos públicos alojados en servidor.</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Archivo Digital (PDF)</label>
                            <input type="file" name="pdfFile" class="form-control" accept=".pdf" required />
                            <small class="form-text text-muted">Archivo protegido para usuarios autenticados.</small>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary px-4">Guardar Producto</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}