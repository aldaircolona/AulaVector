@model Product

@{
    ViewData["Title"] = "Detalle del Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-3">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left"></i> Volver a la lista
        </a>
        <h1 class="h3 mb-0 text-gray-800 mt-2">Detalle de Producto Digital</h1>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-3 text-center mb-3 mb-md-0">
                    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                    {
                        <img src="@Model.CoverImageUrl" alt="@Model.Title" class="img-fluid rounded shadow-sm" style="max-height: 300px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-secondary text-white rounded d-flex align-items-center justify-content-center mx-auto" style="width: 100%; height: 260px;">
                            <i class="bi bi-book fs-1"></i>
                        </div>
                    }
                </div>
                <div class="col-md-9">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h2 class="h4 mb-0 fw-bold">@Model.Title</h2>
                        <span class="fs-4 fw-bold text-success">$@Model.Price.ToString("F2")</span>
                    </div>

                    <p class="text-muted mb-3">@Model.Description</p>

                    <dl class="row mb-0">
                        <dt class="col-sm-3 text-muted">ID de Registro (GUID):</dt>
                        <dd class="col-sm-9"><code class="text-dark">@Model.Id</code></dd>

                        <dt class="col-sm-3 text-muted">Estado:</dt>
                        <dd class="col-sm-9">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo (Soft Delete)</span>
                            }
                        </dd>

                        <dt class="col-sm-3 text-muted">Ruta PDF de Licencia:</dt>
                        <dd class="col-sm-9 text-truncate">
                            <span class="text-break"><i class="bi bi-shield-lock me-1"></i>@(Model.PdfFilePath ?? "No cargado")</span>
                        </dd>

                        <dt class="col-sm-3 text-muted">Fecha Creación:</dt>
                        <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-3 text-muted">Última Modificación:</dt>
                        <dd class="col-sm-9">@(Model.UpdatedAt != default ? Model.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "Sin modificaciones")</dd>
                    </dl>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="bi bi-pencil me-1"></i> Editar Producto
                </a>
            </div>
        </div>
    </div>
</div>